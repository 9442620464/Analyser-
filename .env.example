NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://storebuddy:storebuddy@localhost:5432/storebuddy?schema=public
JWT_SECRET=replace-with-a-long-random-secret

# OpenAI — keep this server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Platform admin (you) — separate from any merchant account. Only seeded if both are set.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Stripe — source of truth for plan + revenue. Price IDs map to the PlanId enum
# (STARTER/GROWTH/PRO); find them under Stripe Dashboard > Product catalog.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Optional: OAuth app credentials for Google / Meta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connections/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/connections/meta/callback

# Encryption key for stored connection secrets (also used for the WhatsApp Business API
# credentials you enter at /admin > WhatsApp — there's no env var for those; they're stored
# encrypted in the database so you can change them without redeploying).
# Use 32 random bytes in base64, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTION_ENCRYPTION_KEY=

# Demo bootstrap account for local development.
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=change-me-now
BOOTSTRAP_STORE_NAME=My Store
