NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Must point at the SAME database as your storebuddy-admin deployment.
DATABASE_URL=postgresql://storebuddy:storebuddy@localhost:5432/storebuddy?schema=public
JWT_SECRET=replace-with-a-long-random-secret

# OpenAI — keep this server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# OAuth app credentials for Google / Meta (per-merchant "Connect" flow lives in this app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connections/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/connections/meta/callback

# Must be the EXACT SAME VALUE as CONNECTION_ENCRYPTION_KEY in storebuddy-admin's .env.
# Both apps read/write the same encrypted PlatformSetting rows (WhatsApp credentials) in the
# shared database — a mismatched key here means this app can't decrypt what admin saved.
# Use 32 random bytes in base64, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTION_ENCRYPTION_KEY=

# Demo bootstrap merchant account for local development.
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=change-me-now
BOOTSTRAP_STORE_NAME=My Store
